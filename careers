                    mobileNavOverlay.classList.add('is-active');
                    mobileToggleBtn.classList.add('is-active');
                    document.body.classList.add('drawer-open');
                }
            }

            if (mobileToggleBtn) mobileToggleBtn.addEventListener('click', toggleDrawer);
            if (mobileDrawerClose) mobileDrawerClose.addEventListener('click', toggleDrawer);
            if (mobileNavOverlay) mobileNavOverlay.addEventListener('click', toggleDrawer);

            // FAQ Accordion Interactivity
            const accordions = document.querySelectorAll('.faq-item');
            accordions.forEach(item => {
                const button = item.querySelector('.faq-header-btn');
                const content = item.querySelector('.faq-content');
                
                button.addEventListener('click', function() {
                    const isActive = item.classList.contains('active');
                    
                    // Close all other items
                    accordions.forEach(el => {
                        el.classList.remove('active');
                        el.querySelector('.faq-header-btn').setAttribute('aria-expanded', 'false');
                        el.querySelector('.faq-content').style.maxHeight = null;
                    });
                    
                    if (!isActive) {
                        item.classList.add('active');
                        button.setAttribute('aria-expanded', 'true');
                        content.style.maxHeight = content.scrollHeight + "px";
                    }
                });
            });

            // Cookie Consent Popup Interaction
            const cookieBanner = document.getElementById('cookieBanner');
            const acceptBtn = document.getElementById('cookieAcceptBtn');
            const rejectBtn = document.getElementById('cookieRejectBtn');

            if (!sessionStorage.getItem('ackey_cookie_consent_session')) {
                setTimeout(function() {
                    if (cookieBanner) {
                        cookieBanner.classList.add('active');
                    }
                }, 600);
            }

            function dismissCookieBanner() {
                if (cookieBanner) {
                    cookieBanner.classList.remove('active');
                }
                sessionStorage.setItem('ackey_cookie_consent_session', 'true');
            }

            if (acceptBtn) acceptBtn.addEventListener('click', dismissCookieBanner);
            if (rejectBtn) rejectBtn.addEventListener('click', dismissCookieBanner);
        });
