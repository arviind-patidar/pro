        /* CSS Variables & Section Padding */
        .careers-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        
        .careers-section {
            padding: 4rem 0;
            position: relative;
        }

        .careers-section-dark {
            background-color: var(--obsidian-black);
            color: var(--white);
            border-radius: 4px;
            margin: 4rem 1.5rem;
            padding: 5rem 3rem;
            border: 0.5px solid rgba(43, 43, 43, 0.3);
            box-shadow: var(--shadow-lux);
        }

        /* Hero Section Split Layout */
        .careers-hero-grid {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding-top: 130px;
            padding-bottom: 4rem;
            max-width: 900px;
            margin: 0 auto;
        }

        .careers-hero-content {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .careers-hero-title {
            font-family: var(--font-heading);
            font-size: clamp(2.2rem, 2rem + 1vw, 2.75rem);
            line-height: 1.2;
            color: var(--obsidian-black);
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
            font-weight: 400;
            letter-spacing: -0.02em;
        }

        .careers-hero-desc {
            font-family: var(--font-body);
            font-size: 1.15rem;
            line-height: 1.65;
            color: var(--neutral-grey);
            margin-bottom: 2.25rem;
        }

        .careers-hero-buttons {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            width: 100%;
        }

        .careers-hero-buttons .sd-btn-gold,
        .careers-hero-buttons .btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 52px;
            padding: 0 2rem;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 4px !important;
            transition: var(--transition-fast);
            cursor: pointer;
            text-decoration: none;
        }

        .careers-hero-buttons .btn-secondary {
            border: 0.5px solid var(--obsidian-black);
            background: transparent;
            color: var(--obsidian-black);
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .careers-hero-buttons .btn-secondary:hover {
            background: var(--obsidian-black);
            color: var(--white);
            transform: translateY(-2px);
        }

        /* Abstract Collaboration Illustration (Right Side) */
        .careers-hero-illustration {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 420px;
        }

        .illustration-bg {
            position: absolute;
            width: 85%;
            height: 85%;
            background: radial-gradient(circle, rgba(43, 43, 43, 0.05) 0%, rgba(244, 241, 234, 0) 70%);
            border-radius: 50%;
            z-index: 1;
        }

        .careers-svg-art {
            width: 90%;
            height: auto;
            z-index: 2;
            filter: drop-shadow(0 12px 28px rgba(13, 27, 36,0.06));
        }

        /* Floating Badges */
        .floating-badge {
            position: absolute;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 0.5px solid rgba(43, 43, 43, 0.25);
            border-radius: 4px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 24px rgba(13, 27, 36, 0.08);
            z-index: 3;
            animation: floatUpDown 4s ease-in-out infinite;
        }

        .badge-1 { top: 12%; left: -5%; animation-delay: 0s; }
        .badge-2 { bottom: 18%; right: -2%; animation-delay: 1.5s; }
        .badge-3 { bottom: 8%; left: 8%; animation-delay: 0.8s; }

        .floating-badge-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(43, 43, 43, 0.12);
            color: var(--refined-brass);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .floating-badge-icon svg { width: 16px; height: 16px; stroke-width: 2.2; }

        .floating-badge-text {
            font-family: var(--font-body);
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--obsidian-black);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        @keyframes floatUpDown {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        /* Our Values: Timeline Layout */
        .values-timeline {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
            margin-top: 3.5rem;
            position: relative;
        }

        .values-timeline::before {
            content: '';
            position: absolute;
            top: 26px;
            left: 10%;
            right: 10%;
            height: 1px;
            background: rgba(43, 43, 43, 0.25);
            z-index: 1;
        }

        .value-node {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .value-circle {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--white);
            border: 2.2px solid rgba(43, 43, 43, 0.35);
            color: var(--refined-brass);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(13, 27, 36, 0.05);
            transition: all var(--transition-fast);
            margin-bottom: 1.25rem;
        }

        .value-node:hover .value-circle {
            transform: scale(1.1);
        }

        .value-circle svg { width: 20px; height: 20px; stroke-width: 2.2; }

        .value-text-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .value-title {
            font-family: var(--font-body);
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--obsidian-black);
            margin-bottom: 0.5rem;
        }

        .value-desc {
            font-family: var(--font-body);
            font-size: 0.85rem;
            line-height: 1.5;
            color: var(--neutral-grey);
            padding: 0 0.5rem;
        }

        /* Who We're Looking For */
        .roles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.75rem;
            margin-top: 3.5rem;
        }

        .role-card {
            background: var(--white);
            border: 0.5px solid rgba(221, 215, 207, 0.35);
            border-radius: 4px;
            padding: 1.75rem 2rem;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            box-shadow: 0 4px 12px rgba(13, 27, 36, 0.03);
            transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
        }

        .role-card:hover {
            transform: translateY(-3px);
            border-color: var(--refined-brass);
            box-shadow: 0 8px 24px rgba(13, 27, 36, 0.06);
        }

        .role-icon {
            width: 44px;
            height: 44px;
            border-radius: 4px;
            background: rgba(43, 43, 43, 0.05);
            color: var(--refined-brass);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .role-icon svg { width: 20px; height: 20px; stroke-width: 2; }

        .role-name {
            font-family: var(--font-heading);
            font-size: 1.15rem;
            color: var(--obsidian-black);
            font-weight: 500;
        }

        /* Life at AcreNKey: Split layout */
        .life-split {
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 4.5rem;
            align-items: center;
        }

        .life-collage {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
            position: relative;
        }

        .collage-img {
            width: 100%;
            height: auto;
            border-radius: 4px;
            box-shadow: 0 8px 24px rgba(13, 27, 36, 0.08);
            object-fit: cover;
            border: 0.5px solid rgba(221, 215, 207, 0.4);
            transition: transform var(--transition-fast), box-shadow var(--transition-fast);
        }

        .collage-img:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(13, 27, 36, 0.12);
        }

        .img-team-main {
            grid-column: span 2;
            height: 330px;
            object-position: center 20%;
        }

        .img-small-1 { height: 160px; object-position: center; }
        .img-small-2 { height: 160px; object-position: center; }

        .life-content {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .life-desc {
            font-family: var(--font-body);
            font-size: 1.05rem;
            line-height: 1.65;
            color: var(--neutral-grey);
            margin-bottom: 2rem;
        }

        .life-bullets {
            display: flex;
            flex-direction: column;
            gap: 1.15rem;
            list-style: none;
            padding: 0;
            width: 100%;
        }

        .life-bullet-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .bullet-circle {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(43, 43, 43, 0.12);
            color: var(--refined-brass);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .bullet-circle svg { width: 14px; height: 14px; stroke-width: 2.5; }

        .bullet-text {
            font-family: var(--font-body);
            font-size: 0.95rem;
            line-height: 1.45;
            color: var(--obsidian-black);
            font-weight: 600;
        }

        /* Current Openings - List State */
        .openings-grid {
            display: flex;
            flex-direction: column;
            gap: 3.5rem;
            margin-top: 3rem;
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .department-section {
            border-bottom: 0.5px solid rgba(43, 43, 43, 0.2);
            padding-bottom: 3.5rem;
        }
        
        .department-title {
            font-family: var(--font-heading);
            font-size: 1.6rem;
            color: var(--obsidian-black);
            margin-bottom: 2rem;
            font-weight: 400;
        }
        
        .roles-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.25rem;
        }
        
        .role-item {
            background: var(--white);
            border: 0.5px solid rgba(43, 43, 43, 0.2);
            border-radius: 4px;
            padding: 1.25rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.4s ease;
            text-decoration: none !important;
            cursor: pointer;
        }
        
        .role-item:hover {
            border-color: var(--refined-brass);
            box-shadow: 0 4px 20px rgba(43, 43, 43, 0.1);
            transform: translateY(-2px);
        }
        
        .role-name-text {
            font-family: var(--font-body);
            font-size: 1rem;
            font-weight: 600;
            color: var(--obsidian-black);
        }
        
        .role-apply-icon {
            color: var(--refined-brass);
            width: 22px;
            height: 22px;
            transition: transform 0.4s ease;
        }
        
        .role-item:hover .role-apply-icon {
            transform: translateX(4px);
        }

        /* Current Openings - Empty State */
        .empty-openings-card {
            background: var(--white);
            border: 0.5px solid rgba(43, 43, 43, 0.3);
            border-radius: 4px;
            padding: 4rem 3rem;
            text-align: center;
            box-shadow: 0 8px 32px rgba(13, 27, 36, 0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 720px;
            margin: 2.5rem auto 0 auto;
        }

        .empty-illustration {
            width: 140px;
            height: auto;
            margin-bottom: 2rem;
            opacity: 0.85;
        }

        .empty-title {
            font-family: var(--font-heading);
            font-size: 1.75rem;
            color: var(--obsidian-black);
            margin-bottom: 0.75rem;
            font-weight: 400;
        }

        .empty-desc {
            font-family: var(--font-body);
            font-size: 1.05rem;
            line-height: 1.6;
            color: var(--neutral-grey);
            margin-bottom: 2rem;
            max-width: 580px;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .careers-hero-grid {
                padding-top: 100px;
            }
            .roles-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .life-split {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            .values-timeline {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            .values-timeline::before {
                display: none;
            }
            .value-node {
                flex-direction: row;
                text-align: left;
                align-items: flex-start;
                gap: 1.25rem;
            }
            .value-text-block {
                align-items: flex-start;
                text-align: left;
            }
            .value-circle {
                margin-bottom: 0;
                flex-shrink: 0;
            }
            .careers-section {
                padding: var(--space-section-mobile) 0;
            }
        }

        @media (max-width: 640px) {
            .floating-badge {
                padding: 6px 12px;
            }
            .floating-badge-text {
                font-size: 0.65rem;
            }
            .floating-badge-icon {
                width: 24px;
                height: 24px;
            }
            .floating-badge-icon svg {
                width: 12px;
                height: 12px;
            }
            .badge-1 { top: 8%; left: 0%; }
            .badge-2 { bottom: 12%; right: 0%; }
            .badge-3 { bottom: 4%; left: 4%; }
            .roles-grid {
                grid-template-columns: 1fr;
            }
            .careers-hero-buttons {
                flex-direction: column;
                gap: 1rem;
            }
            .careers-hero-buttons a {
                width: 100% !important;
            }
            .careers-section-dark {
                margin: 2rem 1rem;
                padding: 3rem 1.5rem;
            }
            .dark-cta-buttons {
                flex-direction: column;
                gap: 1rem;
                width: 100%;
            }
            .dark-cta-buttons a {
                width: 100% !important;
                text-align: center;
                justify-content: center;
            }
            .life-collage {
                grid-template-columns: 1fr 1fr;
                gap: 0.75rem;
            }
            .img-team-main {
                grid-column: span 2;
                height: 220px;
                object-position: center 20%;
            }
            .img-small-1 { height: 110px; }
            .img-small-2 { height: 110px; }
        }
